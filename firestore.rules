// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {uid}
// Fields:
//   - uid: string (required)
//   - email: string (required)
//   - displayName: string (optional)
//   - photoURL: string (optional)
//   - role: string (admin/user)
//   - lastLogin: timestamp (optional)
//
// Collection: posts
// Document ID: {postId}
// Fields:
//   - id: string (optional)
//   - type: string (video/photo/text/audio) (required)
//   - title: string (optional)
//   - content: string (optional)
//   - mediaUrl: string (optional)
//   - createdAt: timestamp (required)
//   - authorUid: string (required)
//
// Collection: login_logs
// Document ID: {logId}
// Fields:
//   - uid: string (required)
//   - email: string (required)
//   - timestamp: timestamp (required)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email == "vovaryzanov2@gmail.com" && request.auth.token.email_verified == true);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUser(data) {
      return data.uid is string && data.email is string;
    }

    function isValidPost(data) {
      return data.type in ['video', 'photo', 'text', 'audio'] &&
             data.createdAt is timestamp &&
             data.authorUid is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{uid} {
      allow read: if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow create: if isAuthenticated() && isOwner(uid) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && isOwner(uid) && isValidUser(request.resource.data);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPost(request.resource.data);
      allow update: if isAdmin() && isValidPost(request.resource.data);
      allow delete: if isAdmin();
    }

    match /login_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }
  }
}
